+            return None, True
+
+        # 精确/去分隔符匹配 skill 名（ccf-humanization / literature_reviewer 等）
+        norm = lambda s: s.lower().replace("_", "").replace("-", "").replace(".", "")
+        for name, skill in _SKILLS.items():
+            if norm(name) == norm(raw):
